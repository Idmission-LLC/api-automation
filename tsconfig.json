{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@tests/*": ["tests/*"],
      "@config/*": ["src/config/*"],
      "@utils/*": ["src/utils/*"],
      "@clients/*": ["src/clients/*"],
      "@types/*": ["src/types/*"],
      "@schemas/*": ["src/schemas/*"],
      "@fixtures/*": ["src/fixtures/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
