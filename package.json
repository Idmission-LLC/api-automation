{
  "name": "api-automation",
  "version": "1.0.0",
  "description": "Enterprise API Automation Framework",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "test:qa": "cross-env ENV=QA playwright test",
    "test:demo": "cross-env ENV=DEMO playwright test",
    "report": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "generate-summary": "ts-node scripts/generate-summary.ts",
    "notify:slack": "ts-node scripts/slack-notification.ts",
    "notify:email": "ts-node scripts/email-notification.ts"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.19.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.9",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "allure-commandline": "^2.27.0",
    "allure-playwright": "^2.14.0",
    "allure-single-html-file": "^0.0.5",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
