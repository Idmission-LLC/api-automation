# Environment Selection (DEV, QA, UAT, PROD)
ENV=QA

# API Credentials (leave blank in example, populate in local .env or CI/CD)
API_USERNAME=
API_PASSWORD=
API_CLIENT_ID=
API_CLIENT_SECRET=
API_TOKEN=
COMPANIES_CREDENTIALS='{"companyA": {"API_USERNAME": "", "API_PASSWORD": "", "API_CLIENT_ID": "", "API_CLIENT_SECRET": ""}}'

# Slack Notification Settings
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Email Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret_password
EMAIL_FROM=automation@example.com
EMAIL_TO=qa@example.com,manager@example.com

# Debug Logs for Allure
ENABLE_DEBUG_LOGS=false
